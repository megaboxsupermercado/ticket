# Banco PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/senhas
DATABASE_SSL=false
# Chave que o totem e o painel usam no endereço (?chave=...)
CHAVE_LOJA=troque-esta-chave
# Senha que os atendentes usam na tela do operador
SENHA_OPERADOR=troque-esta-senha
# Senha do dono para os relatórios
SENHA_DONO=troque-esta-senha
# Texto aleatório longo para assinar os logins
SEGREDO_SESSAO=troque-por-um-texto-aleatorio-longo
# Quantas senhas normais são chamadas antes de uma preferencial
NORMAIS_POR_PREFERENCIAL=2
